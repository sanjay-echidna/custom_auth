<?xml version="1.0"?>
<database xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          name="zed"
          xsi:noNamespaceSchemaLocation="https://static.spryker.com/schema-01.xsd"
          namespace="Orm\Zed\ContactUs\Persistence" package="src.Orm.Zed.ContactUs.Persistence">
    <table name="ech_contact_us" idMethod="native" allowPkInsert="true" phpName="EchContactUs">
        <column name="id" required="true" type="INTEGER" primaryKey="true" autoIncrement="true"/>
        <column name="name" required="true" type="VARCHAR" size="255"/>
        <column name="contact" required="true" type="VARCHAR" size="11"/>
        <column name="subject" required="true" type="VARCHAR" size="255"/>
        <column name="email" required="true" type="VARCHAR" size="255"/>
        <column name="message" required="true" type="LONGVARCHAR"/>
        <id-method-parameter value="ech_contactus_pk_seq"/>
        <behavior name="timestampable">
            <parameter name="created_at" value="true"/>
        </behavior>
    </table>
</database>
