{% extends model('component') %}

{% define config = {
    name: 'add-to-compare-button',
    tag: 'add-to-compare-button'
} %}


{% block body %}
	{% block addcomapre %}

		<button class="add-to-compare-button button__compare button" data="{% if data.metaSku is defined %}{{data.metaSku}}{% else %}{{data.product.sku}}{% endif %}">

			{% if data.product.sku is defined %}
				<i class="fas fa-retweet"></i>
				<span class="compare-text">Add to compare</span>
			{% else %}
				<i class="fas fa-retweet"></i>
			{% endif %}

		</button>

	{% endblock %}
{% endblock %}
