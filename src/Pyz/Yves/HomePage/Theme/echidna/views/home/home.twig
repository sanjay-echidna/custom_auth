{% extends view('home', '@SprykerShop:HomePage') %}

{% block contentTop %}
	{% embed molecule('slick-carousel') with {
        class: 'spacing-bottom spacing-bottom--big',
        modifiers: ['jumbotron'],
        attributes: {
            'slider-config': '{
                "slidesToShow": 1,
                "dots": true,
                "autoplay": true,
                "nextArrow": false,
                "prevArrow": false,
                "autoplaySpeed": 2000,
                "margin": 0,

                "responsive": [{
                     "breakpoint": 1400
                },
                {
                    "breakpoint": 1200
                },
                {
                    "breakpoint": 768
                },
                {
                    "breakpoint": 375,
                    "settings": {
                        "centerMode": false,
                        "autoplay": false
                    }
                }]
            }',
        },
    } only %}
		{% block slides %}
			{% cms_slot 'slt-2' %}
		{% endblock %}
	{% endembed %}
{% endblock %}

{% block content %}
	{% cms_slot 'slt-3' %}
	{% embed organism('section') with {
        modifiers: ['secondary'],
        class: 'spacing-top spacing-top--inner spacing-top--big',
    } only %}
		{% block inner %}
			<div class="grid grid--left grid--middle">
				{% cms_slot 'slt-4' %}
			</div>
		{% endblock %}
	{% endembed %}
{% endblock %}
